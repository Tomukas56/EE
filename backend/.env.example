PORT=3000
NODE_ENV=development
# Prisma reads this URL. Lab DB is Docker Compose on host port 5433
# (./scripts/db-up.sh starts Colima + Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/energy_db
DB_USER=change_me_user
DB_PASSWORD=change_me_strong_password
DB_NAME=energy_db
DB_HOST=127.0.0.1
DB_PORT=5433
JWT_SECRET=change_me_long_random_secret
STRIPE_SECRET_KEY=
# Open Charge Map (https://openchargemap.org/profile/applications)
CPOAPI=
OCM_COUNTRY=LT
OCM_COUNTRIES=LT,LV,EE,PL
OCM_MAX_RESULTS=10000
# Lab-only: owner inbox for confirming user-marked stations. Do not use in production.
APP_OWNER_PIN=
# Snyk API token (https://app.snyk.io/account). Never commit the real value.
SNYK_TOKEN=
